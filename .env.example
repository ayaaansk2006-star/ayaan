# Your real UPI ID (from GPay/PhonePe/Paytm -> profile). Payments go here.
UPI_ID=9833731869@okbizaxis
UPI_NAME=Altitude Moto
ADMIN_PASSWORD=change-this-to-a-long-password
SESSION_SECRET=any-long-random-string
# Gmail: create an App Password at myaccount.google.com/apppasswords
SMTP_USER=altitudemotoindia@gmail.com
SMTP_PASS=
ADMIN_EMAIL=altitudemotoindia@gmail.com
# Razorpay: dashboard.razorpay.com -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://YOUR-DOMAIN/api/razorpay/webhook, events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=
# UPI merchant QR payload (decoded from your GPay QR); amount is appended per order
UPI_QR_PAYLOAD=upi://pay?pa=9833731869@okbizaxis&pn=Altitude%20moto&mc=5571&aid=uGICAgMCCxrnrXg&ver=01&mode=01&tr=BCR2DN4TXLWJXRLF
# Folder for the orders database. On Railway set to the volume mount path, e.g. /app/data
DATA_DIR=
